        <mxCell id="lnk_adm_job" style="strokeColor=#c2185b;strokeWidth=1.5;" edge="1" source="actor_admin" target="uc_macro_job_lifecycle" parent="1"/>
        <mxCell id="lnk_adm_comm" style="strokeColor=#c2185b;strokeWidth=1.5;" edge="1" source="actor_admin" target="uc_macro_community" parent="1"/>
        <mxCell id="lnk_adm_manage" style="strokeColor=#c2185b;strokeWidth=1.5;" edge="1" source="actor_admin" target="uc_macro_admin" parent="1"/>

        <!-- Legend / Notes -->
        <mxCell id="note_box" value="&lt;b&gt;QUY ƯỚC MÔ HÌNH PHÂN CẤP USE CASE (HIERARCHICAL USE CASE CONVENTION):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Sơ đồ Use Case Tổng quát (Summary / Macro Level):&lt;/b&gt; Cho cái nhìn toàn cảnh về phạm vi toàn hệ thống (System Boundary) và 10 nhóm nghiệp vụ chính, gắn kết 4 tác nhân tương tác.&lt;br/&gt;• &lt;b&gt;Sơ đồ Use Case Mức 1 (Level 1 / Detailed Subsystems):&lt;/b&gt; Mỗi nhóm nghiệp vụ trên được phân rã chi tiết thành các Use Case thành phần kèm quan hệ &lt;i&gt;&amp;laquo;include&amp;raquo;&lt;/i&gt;, &lt;i&gt;&amp;laquo;extend&amp;raquo;&lt;/i&gt; trong 4 sơ đồ phân hệ riêng biệt:&lt;br/&gt;  - &lt;i&gt;UseCase_Candidate.drawio&lt;/i&gt; (Phân hệ Sinh viên / Ứng viên)&lt;br/&gt;  - &lt;i&gt;UseCase_Employer.drawio&lt;/i&gt; (Phân hệ Nhà tuyển dụng / Doanh nghiệp)&lt;br/&gt;  - &lt;i&gt;UseCase_Admin.drawio&lt;/i&gt; (Phân hệ Quản trị viên)&lt;br/&gt;  - &lt;i&gt;UseCase_University.drawio&lt;/i&gt; (Phân hệ Cơ sở Giáo dục Đại học)" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fffde7;strokeColor=#fbc02d;fontColor=#f57f17;fontSize=11;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="410" y="1080" width="990" height="120" as="geometry"/>
        </mxCell>

