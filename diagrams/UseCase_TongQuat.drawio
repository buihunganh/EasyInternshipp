<mxfile host="app.diagrams.net" modified="2026-10-08T16:40:00.000Z" agent="EasyInternshipp OOAD" version="24.0.0" type="device">
  <diagram id="usecase-tong-quat" name="Use Case Tổng quát - EasyInternshipp">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title Block -->
        <mxCell id="title_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="900" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="title_text" value="&lt;b style=&quot;font-size: 18px; color: #1a237e;&quot;&gt;SƠ ĐỒ USE CASE TỔNG QUÁT TOÀN HỆ THỐNG (SUMMARY / MACRO USE CASES)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; color: #283593;&quot;&gt;Nền tảng Tuyển dụng Thực tập &amp; Quản trị Tuyển dụng ATS EasyInternshipp (Internships.io)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="25" width="860" height="50" as="geometry"/>
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="boundary" value="&lt;b style=&quot;font-size: 14px; color: #1565c0;&quot;&gt;HỆ THỐNG EASYINTERNSHIPP (SYSTEM BOUNDARY)&lt;/b&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1565c0;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="1080" height="1200" as="geometry"/>
        </mxCell>

        <!-- ==================== 4 MAIN ACTORS ==================== -->

        <!-- Actor 1: Candidate / Student (Left Top) -->
        <mxCell id="actor_candidate" value="Sinh viên / Ứng viên&#xa;(Candidate / Student)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e3f2fd;strokeColor=#1565c0;fontColor=#0d47a1;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="60" height="90" as="geometry"/>
        </mxCell>

        <!-- Actor 2: University Officer (Left Bottom) -->
        <mxCell id="actor_uni" value="Cơ sở Giáo dục Đại học&#xa;(University Officer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fff8e1;strokeColor=#f57f17;fontColor=#e65100;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="880" width="60" height="90" as="geometry"/>
        </mxCell>

        <!-- Actor 3: Employer / Recruiter (Right Top) -->
        <mxCell id="actor_employer" value="Doanh nghiệp / Tuyển dụng&#xa;(Employer / Recruiter)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="320" width="60" height="90" as="geometry"/>
        </mxCell>

        <!-- Actor 4: System Admin (Right Bottom) -->
        <mxCell id="actor_admin" value="Quản trị viên Hệ thống&#xa;(System Administrator)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#880e4f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1650" y="880" width="60" height="90" as="geometry"/>
        </mxCell>

        <!-- ==================== 10 MACRO USE CASES ==================== -->

        <!-- UC 1: Quản lý Tài khoản & Phân quyền (Shared by All) -->
        <mxCell id="uc_macro_auth" value="&lt;b&gt;UC-01: Quản lý Tài khoản &amp; Xác thực Phân quyền&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Đăng ký đa vai trò, Đăng nhập SSO, Phân quyền RBAC)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=12;fontColor=#1a237e;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="690" y="140" width="420" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 2: Hồ sơ & CV Builder (Candidate) -->
        <mxCell id="uc_macro_profile_cv" value="&lt;b&gt;UC-02: Quản lý Hồ sơ Năng lực &amp; Tạo CV Trực tuyến&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(CV Builder, Mẫu thiết kế, Xuất PDF, Chia sẻ Public Link)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;fontColor=#01579b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="410" y="260" width="390" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 3: Hồ sơ Doanh nghiệp & Thẩm định GPKD (Employer + Admin) -->
        <mxCell id="uc_macro_company" value="&lt;b&gt;UC-03: Quản lý Hồ sơ Doanh nghiệp &amp; Thẩm định GPKD&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Company Page, Nộp MST/GPKD, Cấp tích xanh xác thực)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;fontSize=12;fontColor=#311b92;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="990" y="260" width="410" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 4: Đăng tin & Quản lý Việc làm (Employer + Admin + University) -->
        <mxCell id="uc_macro_job_lifecycle" value="&lt;b&gt;UC-04: Đăng tin Tuyển dụng &amp; Quản lý Vòng đời Tin&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Soạn JD, Câu hỏi sàng lọc, Vòng đời 5 pha, Hết hạn tự động)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;fontSize=12;fontColor=#311b92;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="990" y="380" width="410" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 5: Tìm kiếm, Gợi ý & Ứng tuyển 2 chiều (Candidate + Employer) -->
        <mxCell id="uc_macro_apply" value="&lt;b&gt;UC-05: Tìm kiếm Việc làm &amp; Ứng tuyển Chuẩn ATS 2 chiều&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Bộ lọc chuyên sâu, Match %, Nộp đơn, Theo dõi xem CV, Rút đơn)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;fontColor=#01579b;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="410" y="380" width="390" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 6: Phễu Tuyển dụng ATS, Phỏng vấn & Offer (Employer + Candidate) -->
        <mxCell id="uc_macro_ats" value="&lt;b&gt;UC-06: Quản trị Phễu Tuyển dụng ATS, Phỏng vấn &amp; Digital Offer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Kanban nhiều vòng, Scorecard, Lịch phỏng vấn RSVP, Thư mời nhận việc)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;fontColor=#1b5e20;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="680" y="520" width="440" height="70" as="geometry"/>
        </mxCell>

        <!-- UC 7: Nhắn tin Trao đổi 1-1 (Candidate + Employer) -->
        <mxCell id="uc_macro_chat" value="&lt;b&gt;UC-07: Nhắn tin Trực tiếp &amp; Trao đổi Chuyên môn 1-1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Chat thời gian thực, Đính kèm tài liệu test, Video Call)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=12;fontColor=#4a148c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="690" y="660" width="420" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 8: Cổng Hướng nghiệp Đại học & Xác thực SV (University + Candidate + Employer) -->
        <mxCell id="uc_macro_university" value="&lt;b&gt;UC-08: Hợp tác Doanh nghiệp, Cổng Hướng nghiệp ĐH &amp; Career Fair&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Xác thực sinh viên, Duyệt tin MoU độc quyền, Báo cáo thực tập)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f57f17;fontSize=12;fontColor=#e65100;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="410" y="800" width="430" height="70" as="geometry"/>
        </mxCell>

        <!-- UC 9: Diễn đàn Cộng đồng & Review (Candidate + Admin) -->
        <mxCell id="uc_macro_community" value="&lt;b&gt;UC-09: Diễn đàn Thực tập &amp; Đánh giá Môi trường Doanh nghiệp&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Kinh nghiệm phỏng vấn, Hỏi đáp ẩn danh, Đánh giá review thực tập)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=12;fontColor=#004d40;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="410" y="940" width="410" height="65" as="geometry"/>
        </mxCell>

        <!-- UC 10: Quản trị Hệ thống, Kiểm duyệt & An toàn (Admin) -->
        <mxCell id="uc_macro_admin" value="&lt;b&gt;UC-10: Kiểm duyệt Toàn diện, Xử lý Vi phạm &amp; Nhật ký Audit Log&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Hàng đợi duyệt tin, Xử lý khiếu nại tin xấu/lừa đảo, Khóa tài khoản, Audit Trail)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=12;fontColor=#880e4f;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="960" y="940" width="440" height="70" as="geometry"/>
        </mxCell>

        <!-- ==================== ASSOCIATIONS (ACTOR TO MACRO USE CASES) ==================== -->

