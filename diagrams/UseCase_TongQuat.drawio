        <mxCell id="lnk_cand_auth" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_auth" parent="1"/>
        <mxCell id="lnk_cand_cv" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_profile_cv" parent="1"/>
        <mxCell id="lnk_cand_apply" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_apply" parent="1"/>
        <mxCell id="lnk_cand_ats" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_ats" parent="1"/>
        <mxCell id="lnk_cand_chat" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_chat" parent="1"/>
        <mxCell id="lnk_cand_community" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_community" parent="1"/>
        <mxCell id="lnk_cand_uni" style="strokeColor=#1565c0;strokeWidth=1.5;" edge="1" source="actor_candidate" target="uc_macro_university" parent="1"/>

        <!-- Employer Links -->
        <mxCell id="lnk_emp_auth" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_auth" parent="1"/>
        <mxCell id="lnk_emp_comp" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_company" parent="1"/>
        <mxCell id="lnk_emp_job" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_job_lifecycle" parent="1"/>
        <mxCell id="lnk_emp_ats" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_ats" parent="1"/>
        <mxCell id="lnk_emp_chat" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_chat" parent="1"/>
        <mxCell id="lnk_emp_apply" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_apply" parent="1"/>
        <mxCell id="lnk_emp_uni" style="strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" source="actor_employer" target="uc_macro_university" parent="1"/>

        <!-- University Officer Links -->
        <mxCell id="lnk_uni_auth" style="strokeColor=#f57f17;strokeWidth=1.5;" edge="1" source="actor_uni" target="uc_macro_auth" parent="1"/>
