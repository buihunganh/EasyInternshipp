        <mxCell id="title" value="Use Case Diagram — Phân hệ Cơ sở Giáo dục &amp; Ban Hướng nghiệp ĐH (University Career Center Module)&#xa;Hệ thống Tuyển dụng Thực tập EasyInternshipp (Internships.io) — Mô hình Chuẩn Handshake" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontStyle=1;fontColor=#004d40;" vertex="1" parent="1">
