# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API keys.

# Used by the browser (bundled into the site): public URL and anon key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Server-side only: seed script and E2E factories. Never prefix with VITE_, never commit.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
